---
import { Icon } from 'astro-icon/components';
import Puck3D from './Puck3D.astro';

const specs = [
  { value: 'Unique', title: 'Il n’ouvre que tes applications.', body: 'Chaque Socle a son propre identifiant. Une carte ou un badge sans contact ne débloque rien.', icon: 'ph:contactless-payment' },
  { value: 'Sans pile', title: 'Rien à recharger.', body: 'Le Socle est alimenté par ton téléphone au moment où il le touche.', icon: 'ph:lightning-slash' },
  { value: 'Multi-pièces', title: 'Un Socle par pièce.', body: 'Un sur le bureau, un sur la table de nuit. Associe-en autant que tu veux.', icon: 'ph:squares-four' },
  { value: 'Sans code', title: 'Rien à contourner.', body: 'Pas de mot de passe à retenir, pas de réglage à désactiver. Le Socle, ou rien.', icon: 'ph:lock-key' },
];
---

<section id="objet" class="mx-auto max-w-[1240px] px-4 py-28 md:px-8 md:py-40">
  <div class="text-center">
    <h2 class="reveal mx-auto max-w-[16ch] text-[clamp(2.2rem,4.6vw,3.8rem)] leading-[1.02] font-medium tracking-[-0.04em]">Le Socle, en bref.</h2>
    <p class="reveal mx-auto mt-5 max-w-[46ch] text-lg leading-relaxed text-muted">
      Un petit palet à poser sur ton bureau ou ta table de nuit. Ton téléphone le reconnaît, et lui seul peut rendre tes applications.
    </p>
  </div>

  <div data-object-stage class="relative mx-auto my-10 w-[min(760px,100%)] md:my-16">
    <div class="spot" aria-hidden="true"></div>
    <Puck3D id="object" class="aspect-[4/3] w-full" fit={0.62} elev={14} led="on" />
  </div>

  <div class="grid gap-3 sm:grid-cols-2">
    {
      specs.map((s) => (
        <article class="reveal tone rounded-[28px] bg-card p-7 md:p-9">
          <div class="flex items-start justify-between gap-4">
            <p class="text-[clamp(2rem,3.6vw,2.75rem)] leading-none font-medium tracking-[-0.04em]">{s.value}</p>
            <Icon name={s.icon} class="text-2xl text-muted" />
          </div>
          <p class="mt-8 font-medium">{s.title}</p>
          <p class="mt-1.5 max-w-[44ch] text-[0.9375rem] leading-relaxed text-muted">{s.body}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .spot {
    position: absolute;
    inset: -30%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--fg) 12%, transparent), transparent);
  }
</style>
