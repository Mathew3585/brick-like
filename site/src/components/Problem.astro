---
/** Le constat, lu mot à mot au fil du défilement : chaque mot s'allume quand on y arrive. */
const text =
  "Tu prends ton téléphone pour regarder l'heure. Vingt minutes plus tard, tu es encore sur une vidéo que tu n'as pas choisie. Ce n'est pas un manque de volonté : ces apps sont faites pour te retenir.";
const words = text.split(' ');
---

<section class="mx-auto max-w-[1240px] px-4 py-32 md:px-8 md:py-48">
  <p data-words class="max-w-[24ch] text-[clamp(1.9rem,4.4vw,3.6rem)] leading-[1.12] font-medium tracking-[-0.035em]">
    {
      words.map((w) => (
        <>
          <span class="word">{w}</span>{' '}
        </>
      ))
    }
  </p>
</section>

<style>
  .word {
    opacity: 0.16;
  }
  :global(.reduced) .word,
  :global(.no-js) .word {
    opacity: 1;
  }
</style>
