---
import Phone from './Phone.astro';
import Puck3D from './Puck3D.astro';
import HomeScreen from './screens/HomeScreen.astro';
import LockedScreen from './screens/LockedScreen.astro';

/**
 * La séquence centrale, épinglée : choisir un mode, poser le téléphone sur le Socle, tout se tait.
 * Au contact, la page entière passe du papier à l'encre, comme l'app. Animée dans scripts/motion.ts.
 */
const steps = [
  { title: 'Choisis un mode.', body: "Travail, Lecture, Soir : chaque mode a sa liste d'apps. Puis la durée, de 25 minutes à 2 heures, ou libre." },
  { title: 'Pose-le sur le Socle.', body: 'Le haut du téléphone contre le Socle. Une vibration, un son, et la session commence.' },
  { title: 'Tout se tait.', body: "Les apps du mode passent en pause, leurs notifications disparaissent. L'anneau se remplit jusqu'à ton objectif." },
];
---

<section id="fonctionnement" data-lock class="relative">
  <div class="mx-auto grid min-h-[100dvh] max-w-[1240px] grid-cols-[minmax(0,1fr)] grid-rows-[auto_1fr] items-center gap-6 px-4 pt-24 pb-8 md:px-8 lg:grid-cols-2 lg:grid-rows-1 lg:pt-0 lg:pb-0">
    <div data-lock-steps class="grid">
      {
        steps.map((s, i) => (
          <div data-step={i} class="col-start-1 row-start-1 max-w-[440px]">
            <h2 class="text-[clamp(2.2rem,5vw,4rem)] leading-[1.02] font-medium tracking-[-0.04em]">{s.title}</h2>
            <p class="mt-4 max-w-[38ch] text-base leading-relaxed text-muted md:mt-5 md:text-lg">{s.body}</p>
          </div>
        ))
      }
    </div>

    <div data-lock-scene class="relative flex h-full flex-col items-center justify-center [perspective:1400px]">
      <div class="scene-spot" aria-hidden="true"></div>
      <div data-lock-phone class="relative z-10 [transform-style:preserve-3d] will-change-transform">
        <Phone label="L'app Socle passe de l'accueil à une session verrouillée" class="[--w:min(210px,22dvh,48vw)] lg:[--w:min(240px,27dvh)]">
          <HomeScreen id="lock" />
          <LockedScreen id="lock" class="opacity-0" start={0} />
        </Phone>
      </div>
      <div data-lock-puck class="relative -mt-[30%] w-[calc(min(210px,22dvh,48vw)*2.4)] lg:w-[calc(min(240px,27dvh)*2.4)]">
        <Puck3D id="lock" class="aspect-[2.4/1.4] w-full" fit={0.56} elev={28} />
      </div>
    </div>
  </div>
</section>

<style>
  [data-step]:not([data-step="0"]) {
    opacity: 0;
  }
  /* Lumière douce sous le palet, pour qu'il reste lisible une fois la page à l'encre. */
  .scene-spot {
    position: absolute;
    left: 50%;
    bottom: 8%;
    width: 120%;
    aspect-ratio: 2;
    translate: -50% 0;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--fg) 9%, transparent), transparent);
    pointer-events: none;
  }
  /* Sans animation : les trois étapes à la suite, la session déjà verrouillée. */
  :global(.reduced) [data-lock-steps],
  :global(.no-js) [data-lock-steps] {
    gap: 2.5rem;
  }
  :global(.reduced) [data-step],
  :global(.no-js) [data-step] {
    grid-row: auto;
    opacity: 1 !important;
  }
  :global(.reduced [data-lock] [data-screen="locked"]),
  :global(.no-js [data-lock] [data-screen="locked"]) {
    opacity: 1;
  }
</style>
