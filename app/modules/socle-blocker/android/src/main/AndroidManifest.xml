<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.NFC" />
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-feature android:name="android.hardware.nfc" android:required="false" />

  <!-- Lets the module list every launchable app without QUERY_ALL_PACKAGES. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application>
    <service
      android:name="expo.modules.socleblocker.SocleAccessibilityService"
      android:exported="false"
      android:label="@string/socle_accessibility_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/socle_accessibility" />
    </service>

    <activity
      android:name="expo.modules.socleblocker.ShieldActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:taskAffinity="expo.modules.socleblocker.shield"
      android:screenOrientation="portrait"
      android:theme="@style/SocleShield" />
  </application>
</manifest>
